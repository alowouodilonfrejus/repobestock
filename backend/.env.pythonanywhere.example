# Configuration backend pour PythonAnywhere + Neon (base PostgreSQL).
# Copier ce fichier vers PythonAnywhere en tant que ".env" dans le dossier de l'app.
# Remplacer <...> par tes valeurs.

# Endpoint Neon (mode "pooled" recommandé) avec SSL requis pour asyncpg
DATABASE_URL=postgresql+asyncpg://<neon-user>:<neon-password>@<host-pooler>.neon.tech/<database>?sslmode=require

# Cle secrete : 32+ caracteres (sinon PyJWT emet un avertissement)
SECRET_KEY=changez-moi-par-une-cle-de-32-caracteres-minimum

# Obligatoire sur PythonAnywhere (app servie via WSGI, 1 boucle d'evenements par requete)
USE_NULLPOOL=true

# Compte super admin cree au premier demarrage (python -m app.internal_data)
FIRST_SUPERUSER_EMAIL=admin@bestock.dev
FIRST_SUPERUSER_PASSWORD=changez-moi
FIRST_SUPERUSER_USERNAME=superadmin

# Duree de vie des tokens (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080